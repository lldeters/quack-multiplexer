# Credentials of the docker compose end-to-end test. They are test values:
# not secret, and never to be used anywhere else.
#
# run.sh sources this file and passes it to docker compose (--env-file).
# config/users.yaml stores the sha256 of the client tokens, config/admin.token
# holds E2E_ADMIN_TOKEN and config/gateway*.yaml hold the engine tokens;
# "go test ./test/e2e/" checks that all of them agree. Values must consist of
# [A-Za-z0-9._-] because they are embedded in SQL, YAML and token options.

# Client tokens (auth.mode=static, config/users.yaml).
E2E_ALICE_TOKEN=e2e-alice-3f9c2b7d1a8e4c60
E2E_BOB_TOKEN=e2e-bob-8a1d6e2f9b3c7051
# A token that no user has.
E2E_WRONG_TOKEN=e2e-wrong-0000000000000000

# Bearer token of the admin API (config/admin.token).
E2E_ADMIN_TOKEN=e2e-admin-5c7e9a1b3d2f4068

# QUACK_TOKEN of the engines; the gateways' static provider uses them.
E2E_ENGINE_SHARED_TOKEN=e2e-engine-shared-6b2d8f4a0c1e3957
E2E_ENGINE_ANALYTICS_TOKEN=e2e-engine-analytics-9e4a2c6b8d0f1735

# QUACKMUX_SESSION_KEY of both gateways (seals the connection ids).
E2E_SESSION_KEY=e2e-session-key-1d3f5b7a9c2e4068
